# Local dev values are printed by `supabase status` after `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Needed only once the send-bill / send-push Edge Functions are wired to real providers (see the
# TODOs in supabase/functions/*/index.ts) -- none of this is required to run the backend locally.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=
PAYMENT_GATEWAY=          # razorpay | cashfree | phonepe -- not yet decided, see README "Open questions"
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
