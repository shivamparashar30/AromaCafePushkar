{
  "expo": {
    "name": "Aroma Cafe Pushkar",
    "slug": "restro-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "restro",
    "platforms": [
      "android",
      "ios"
    ],
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aroma Cafe to use your camera to scan table QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.neshama.restromobile",
      "splash": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "splash": {
        "backgroundColor": "#FFFFFF"
      }
    }
  }
}
